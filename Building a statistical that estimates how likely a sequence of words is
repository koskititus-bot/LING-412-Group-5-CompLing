import math
from collections import Counter, defaultdict


class StatisticalLanguageModel:

  def __init__(self, corpus):
    """Initializes the language model with a text corpus (list of sentences)."""
    self.corpus = corpus
    self.unigram_counts = Counter()
    self.bigram_counts = Counter()
    self.trigram_counts = Counter()
    self.vocabulary = set()

    self._train()

  def _preprocess_and_tokenize(self, sentence):
    """Tokenizes a sentence and adds padding for N-gram models."""
    tokens = sentence.lower().split()
    return tokens

  def _train(self):
    """Counts unigrams, bigrams, trigrams and builds the vocabulary."""
    for sentence in self.corpus:
      tokens = self._preprocess_and_tokenize(sentence)
      # Pad sentences with start (<s>) and end (</s>) tokens
      # Trigram needs two start tokens, bigram needs one
      padded_tokens = ["<s>", "<s>"] + tokens + ["</s>"]

      for i in range(len(padded_tokens)):
        token = padded_tokens[i]
        self.unigram_counts[token] += 1
        self.vocabulary.add(token)

        # Bigram history: 1 previous word
        if i >= 1:
          bigram = (padded_tokens[i - 1], token)
          self.bigram_counts[bigram] += 1

        # Trigram history: 2 previous words
        if i >= 2:
          trigram = (padded_tokens[i - 2], padded_tokens[i - 1], token)
          self.trigram_counts[trigram] += 1

    self.vocab_size = len(self.vocabulary)

  # --- BIGRAM MODEL ---
  def bigram_probability(self, word, prev_word, smoothed=True):
    """Calculates P(word | prev_word) with optional Laplace smoothing."""
    bigram = (prev_word, word)
    if smoothed:
      # Laplace (Add-1) Smoothing formula: (C(w_i-1, w_i) + 1) / (C(w_i-1) + V)
      numerator = self.bigram_counts[bigram] + 1
      denominator = self.unigram_counts[prev_word] + self.vocab_size
      return numerator / denominator
    else:
      # Maximum Likelihood Estimation (MLE) without smoothing
      prev_count = self.unigram_counts[prev_word]
      if prev_count == 0:
        return 0.0
      return self.bigram_counts[bigram] / prev_count

  def score_sentence_bigram(self, sentence, smoothed=True):
    """Calculates the probability of a full sentence using the bigram model."""
    tokens = self._preprocess_and_tokenize(sentence)
    padded_tokens = ["<s>"] + tokens + ["</s>"]
    probability = 1.0

    for i in range(1, len(padded_tokens)):
      prev_word = padded_tokens[i - 1]
      word = padded_tokens[i]
      prob = self.bigram_probability(word, prev_word, smoothed)
      probability *= prob

    return probability

  # --- TRIGRAM MODEL ---
  def trigram_probability(self, word, prev_prev_word, prev_word, smoothed=True):
    """Calculates P(word | prev_prev_word, prev_word) with optional Laplace smoothing."""
    trigram = (prev_prev_word, prev_word, word)
    bigram_history = (prev_prev_word, prev_word)

    if smoothed:
      # Laplace (Add-1) Smoothing for Trigrams
      numerator = self.trigram_counts[trigram] + 1
      denominator = self.bigram_counts[bigram_history] + self.vocab_size
      return numerator / denominator
    else:
      # MLE without smoothing
      history_count = self.bigram_counts[bigram_history]
      if history_count == 0:
        return 0.0
      return self.trigram_counts[trigram] / history_count

  def score_sentence_trigram(self, sentence, smoothed=True):
    """Calculates the probability of a full sentence using the trigram model."""
    tokens = self._preprocess_and_tokenize(sentence)
    padded_tokens = ["<s>", "<s>"] + tokens + ["</s>"]
    probability = 1.0

    for i in range(2, len(padded_tokens)):
      prev_prev_word = padded_tokens[i - 2]
      prev_word = padded_tokens[i - 1]
      word = padded_tokens[i]
      prob = self.trigram_probability(
          word, prev_prev_word, prev_word, smoothed
      )
      probability *= prob

    return probability



